          "raw": "http://127.0.0.1:8000/api/auth/login/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "auth", "login", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_number\": \"20220236\",\n  \"password\": \"password123\"\n}"
        }
      }
    },
    {
